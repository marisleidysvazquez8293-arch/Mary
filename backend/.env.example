#--------------------------------------------------------------------
# SADE backend — variables de entorno
# Copia a backend/.env (o exporta en el shell / docker-compose)
# NUNCA subas secretos ni el JSON de cuenta de servicio al git
#--------------------------------------------------------------------

DJANGO_DEBUG=1
DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
SADE_SOFTWARE_VERSION=1.0.0

# PostGIS
POSTGRES_DB=sade
POSTGRES_USER=sade
POSTGRES_PASSWORD=sade
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

#--------------------------------------------------------------------
# Google Earth Engine (adquisición)
# Sin estas variables el API arranca en modo degradado (no crash).
#--------------------------------------------------------------------

# Opción A (recomendada): JSON de cuenta de servicio
# GOOGLE_APPLICATION_CREDENTIALS=/ruta/absoluta/sade-gee-sa.json

# Opción B: email + ruta a JSON o PEM
# GEE_SERVICE_ACCOUNT=sade-gee@TU_PROYECTO.iam.gserviceaccount.com
# GEE_PRIVATE_KEY_PATH=/ruta/absoluta/sade-gee-sa.json

# Opción C: email + PEM inline (usar \n escapados)
# GEE_SERVICE_ACCOUNT=sade-gee@TU_PROYECTO.iam.gserviceaccount.com
# GEE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Proyecto GCP registrado en Earth Engine (opcional pero recomendado)
# GEE_PROJECT=tu-proyecto-gcp

# Registrar la cuenta de servicio en
# https://code.earthengine.google.com/register
# y otorgar rol Earth Engine Resource Viewer / User en el proyecto.
