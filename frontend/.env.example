# URL base de la API. Vacío = usar rutas relativas /api (proxy de Vite en desarrollo).
# Ejemplo producción / backend remoto:
# VITE_API_URL=http://127.0.0.1:8000
VITE_API_URL=

# Destino del proxy de desarrollo (vite.config.ts)
VITE_PROXY_TARGET=http://127.0.0.1:8000

# Autenticación Basic (el backend DRF exige usuario autenticado + rol SADE)
VITE_API_USER=
VITE_API_PASSWORD=

# ID de ConjuntoPesosAHP para el botón «Ejecutar (demo)»
VITE_DEMO_CONJUNTO_PESOS_ID=1
